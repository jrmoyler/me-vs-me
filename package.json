{
  "name": "me-vs-me",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/vercel-promo-build.mjs",
    "render:promo": "node scripts/stage-promo.mjs && remotion render video/src/index.ts Promo dist/me-vs-me-nine-fighters-30s.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "package:offline": "node scripts/package-offline.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.392",
    "phaser": "^3.90.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "^4.0.392",
    "vite": "^7.1.0",
    "@sparticuz/chromium": "^140.0.0"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "esbuild": "^0.27.0"
  }
